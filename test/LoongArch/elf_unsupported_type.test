## Reject unsupported ELF file types other than ET_REL.
## SPDX-License-Identifier: GPL-3.0-or-later

# RUN: yaml2obj %s -o %t
# RUN: not loonglint %t 2>&1 | FileCheck %s

# CHECK: loonglint: error: unsupported ELF type in '{{.*}}': expected ET_EXEC or ET_DYN

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_CORE
  Machine: EM_LOONGARCH
