## Reject ELF for another machine architecture.
## SPDX-License-Identifier: GPL-3.0-or-later

# RUN: yaml2obj %s -o %t
# RUN: not loonglint %t 2>&1 | FileCheck %s

# CHECK: loonglint: error: unsupported ELF machine in '{{.*}}': expected LoongArch

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
