## Reject linked ELF without a non-empty executable section.
## SPDX-License-Identifier: GPL-3.0-or-later

# RUN: yaml2obj %s -o %t
# RUN: not loonglint --color=false %t 2>&1 | FileCheck %s

# CHECK: loonglint: error: no non-empty executable sections in '{{.*}}'

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_LOONGARCH
Sections:
  - Name:    .data
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Address: 0x10000
    Content: "00000000"
