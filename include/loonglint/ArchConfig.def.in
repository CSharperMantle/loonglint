//
// Configured by the build system to enumerate the architectures loonglint was built with. Consume
// via X-macros; contains nothing but macro invocations, so it is safe to include in any scope, as
// many times as needed:
//
//   #define LOONGLINT_ARCH(ArchName) ...
//   #include "loonglint/ArchConfig.def"
//   #undef LOONGLINT_ARCH
//
// The variant of this file without the .in suffix has been generated by CMake. Do not edit!

#ifndef LOONGLINT_ARCH
#error Please define the macro LOONGLINT_ARCH(ArchName)
#endif

@LOONGLINT_ENUM_ARCHS@

#undef LOONGLINT_ARCH
